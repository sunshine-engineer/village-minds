# File: .env.example
# Purpose: Optional environment overrides; the application does not load .env files.
# Maintainer: sunshine-engineer
# Modified: 2026-10-23
# Export selected values in your shell; omit unused overrides.
# VILLAGE_CONFIG=examples/custom.json
# VILLAGE_MODEL=qwen2.5:1.5b
# OLLAMA_URL=http://localhost:11434
# For a profile with api_key_env="LOCAL_MODEL_API_KEY", set that variable yourself.
# LOCAL_MODEL_API_KEY=replace-locally-if-required
# Never commit .env files, credentials, private saves or dialogue logs.
